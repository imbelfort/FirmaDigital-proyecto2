# ===================================================================
# SISTEMA DE FIRMA DIGITAL Y TITULACIÓN ACADÉMICA - UAGRM
# Archivo de Configuración de Variables de Entorno (.env.example)
# ===================================================================

# -------------------------------------------------------------------
# 1. CONFIGURACIÓN BÁSICA DE LA APLICACIÓN
# -------------------------------------------------------------------
APP_NAME="FirmaDigital_UAGRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# -------------------------------------------------------------------
# 2. BASE DE DATOS (PostgreSQL - Estructura BD.md)
# -------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=db_grupo26sa
DB_USERNAME=postgres
DB_PASSWORD=tu_password_postgres

# -------------------------------------------------------------------
# 3. SESIONES, CACHÉ Y ARCHIVOS
# -------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
FILESYSTEM_DISK=public

# -------------------------------------------------------------------
# 4. PASARELA DE PAGO - PAGOFÁCIL QR (Bolivia)
# -------------------------------------------------------------------
# URL del servicio API de PagoFácil (v2)
PAGOFACIL_BASE_URL=https://masterqr.pagofacil.com.bo/api/services/v2

# Credenciales entregadas por PagoFácil para el comercio
PAGOFACIL_TOKEN_SERVICE=tu_token_service_pagofacil
PAGOFACIL_TOKEN_SECRET=tu_token_secret_pagofacil

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# -------------------------------------------------------------------
# 5. FIRMA DIGITAL / ADSIB (Simulador y Verificador Criptográfico RSA)
# -------------------------------------------------------------------
# Clave o passphrase institucional para emisión de firmas
FIRMA_DIGITAL_SECRET=UAGRM_VICERRECTORADO_KEY_2026

# -------------------------------------------------------------------
# 6. FRONTEND (Vite / Vue 3)
# -------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
